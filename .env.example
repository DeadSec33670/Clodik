# --- ArhoShop server config ---
# Скопируйте в .env и заполните для продакшена.

# HTTP
PORT=3000

# Безопасность сессий (обязательно поменяйте в проде!)
ARHO_SECRET=please-change-me-to-a-long-random-string
# Время жизни токена в секундах (по умолчанию 30 дней)
ARHO_TOKEN_TTL=2592000

# Пароль входа в админ-панель /admin (обязательно поменяйте в проде!)
ARHO_ADMIN_PASSWORD=admin

# База данных (SQLite-файл). Для Postgres см. docs/DEPLOYMENT.md
ARHO_DB=server/data/arho.sqlite

# --- Email (восстановление пароля, подтверждение заказа) ---
# console | resend | sendgrid
EMAIL_DRIVER=console
EMAIL_FROM=ArhoShop <noreply@arhoshop.ru>
# RESEND_API_KEY=
# SENDGRID_API_KEY=

# --- Оплата ---
# stub | yookassa
PAYMENT_DRIVER=stub
PAYMENT_RETURN_URL=https://arhoshop.ru/order
# YOOKASSA_SHOP_ID=
# YOOKASSA_SECRET=
